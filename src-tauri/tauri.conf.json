{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seer Classic",
  "version": "0.3.2",
  "identifier": "local.chizhuoni.seer-classic",
  "build": {
    "beforeDevCommand": "npm run dev -- --mode desktop",
    "beforeBuildCommand": "npm run build:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "赛尔经典 · Seer Classic",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "create": false,
        "visible": false,
        "preventOverflow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Game",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
