{
  "name": "seer-classic",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.mjs\" \"battle/**/*.test.mjs\" \"raising/**/*.test.mjs\" \"tools/distribution/**/*.test.mjs\"",
    "verify": "node tools/verification/run.mjs",
    "package": "tsc --noEmit && node tools/distribution/pack_browser.mjs",
    "dev:preview": "vite --host 127.0.0.1 --port 1421"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.7.1",
    "@seer-pet-anim/swf-bundle": "0.3.1",
    "@seer-pet-anim/swf-renderer": "0.3.1",
    "pixi.js": "8.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright-core": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
